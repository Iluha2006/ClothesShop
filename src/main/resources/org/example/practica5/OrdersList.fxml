<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="600.0" minWidth="800.0" spacing="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.practica5.Controller.OrdersListController">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" minHeight="50" prefHeight="86.0" prefWidth="779.0" spacing="15.0" style="-fx-background-color: green; -fx-background-radius: 5;">
        <Label prefHeight="18.0" prefWidth="462.0" text="Мои заказы" textFill="#fffdfd" HBox.hgrow="ALWAYS">
            <HBox.margin>
                <Insets left="15.0" />
            </HBox.margin>
        </Label>
      <VBox prefHeight="86.0" prefWidth="368.0">
         <children>
            <Label fx:id="NameUser" prefHeight="42.0" prefWidth="321.0" text="ФИО: " textFill="#f7eeee" />
            <Label fx:id="RoleUser" prefHeight="28.0" prefWidth="318.0" text="Роль: " textFill="WHITE" />
         </children>
      </VBox>

        
    </HBox>

    <Separator />

    <ListView fx:id="ordersListView" style="-fx-background-color: #f5f5f5; -fx-background-radius: 5;" VBox.vgrow="ALWAYS" />

    <Separator />

    <HBox alignment="CENTER_RIGHT" spacing="10.0">

        <Button fx:id="btnEditOrder"  text="Редактировать" />
        <Button fx:id="btnDeleteOrder"  text="Удалить" />
        <Button fx:id="btnAddOrder"  text="Добавить заказ" />
        <Button fx:id="btnBackProducts" text="выйти" />
    </HBox>

</VBox>
