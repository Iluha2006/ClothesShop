<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Pos?>


<AnchorPane fx:controller="org.example.practica5.PartnerController"
            maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="650.0" prefWidth="700.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">
    <children>

        <HBox alignment="CENTER" layoutX="0.0" layoutY="14.0"
              prefHeight="54.0" prefWidth="700.0" spacing="20.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <Label text="Партнеры" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        </HBox>


        <HBox alignment="CENTER_LEFT" layoutX="0.0"    layoutY="14.0"
              prefHeight="54.0" prefWidth="700.0" spacing="40.0"
              style="-fx-padding: 0 0 0 30;"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children >
                <ImageView  fitHeight="54.0" fitWidth="76.0" pickOnBounds="true" preserveRatio="true">
                    <image >
                        <Image  url="@images/master.png" />
                    </image>
                </ImageView>

            </children>
        </HBox>


        <ListView fx:id="listPartner"
                  layoutX="50.0" layoutY="80.0"
                  prefHeight="480.0" prefWidth="600.0"
                  AnchorPane.leftAnchor="50.0"
                  AnchorPane.rightAnchor="50.0"
                  AnchorPane.topAnchor="80.0" />


        <HBox alignment="CENTER" layoutX="0.0" layoutY="580.0"
              prefHeight="50.0" prefWidth="700.0" spacing="20.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
              AnchorPane.bottomAnchor="10.0">
            <children>
                <Button mnemonicParsing="false"
                        prefHeight="35.0" prefWidth="180.0"
                        text="Добавить партнера" />

                <Button mnemonicParsing="false"
                        prefHeight="35.0" prefWidth="220.0"
                        text="Редактировать данные партнера" />

                <Button mnemonicParsing="false"
                        prefHeight="35.0" prefWidth="180.0"
                        text="История партнера" />
            </children>
        </HBox>

    </children>
</AnchorPane>