<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<HBox spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.practica5.Controller.AddEditProductController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>


    <VBox alignment="TOP_CENTER" spacing="15.0" prefWidth="200">
        <Label text="Изображение товара" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <ImageView fx:id="productImageView"
                   fitHeight="200"
                   fitWidth="200"
                   preserveRatio="true"
                   style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-color: #f5f5f5;"/>

        <Button text="Выбрать изображение"
                onAction="#chooseImage"
                style="-fx-background-color: #3498db; -fx-text-fill: white;"/>

        <Label text="Поддерживаемые форматы:" style="-fx-font-size: 10px; -fx-text-fill: #666;"/>
        <Label text="PNG, JPG, JPEG, GIF" style="-fx-font-size: 10px; -fx-text-fill: #666;"/>
    </VBox>


    <VBox spacing="15.0" HBox.hgrow="ALWAYS">
        <Label fx:id="formTitle" text="Добавление товара" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <Separator/>

        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" hgrow="NEVER" prefWidth="150"/>
                <ColumnConstraints hgrow="ALWAYS" prefWidth="300"/>
            </columnConstraints>

            <Label text="Артикул:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="articleField" promptText="Введите артикул" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Название товара:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="productNameCombo"  promptText="Выберите название товара "
                      GridPane.columnIndex="1" GridPane.rowIndex="1"></ComboBox>

            <Label text="Категория:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <ComboBox fx:id="categoryCombo" promptText="Выберите категорию"
                      GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Поставщик:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <ComboBox fx:id="providerCombo" promptText="Выберите поставщика"
                      GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Производитель:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <ComboBox fx:id="manufacturerCombo" promptText="Выберите производителя"
                      GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <Label text="Количество:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <Spinner fx:id="quantitySpinner" editable="true"
                     GridPane.columnIndex="1" GridPane.rowIndex="5"/>

            <Label text="Единица измерения:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
            <ComboBox fx:id="unitCombo" promptText="Выберите единицу измерения"
                      editable="true" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

            <Label text="Цена:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
            <TextField fx:id="priceField" promptText="Введите цену" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

            <Label text="Скидка:" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
            <Spinner fx:id="discountSpinner" editable="true"
                     GridPane.columnIndex="1" GridPane.rowIndex="8"/>

            <Label text="Описание:" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
            <TextArea fx:id="descriptionArea" promptText="Введите описание товара"
                      prefHeight="100" GridPane.columnIndex="1" GridPane.rowIndex="9"/>

            <Label text="Путь к изображению:" GridPane.columnIndex="0" GridPane.rowIndex="10"/>
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="10">
                <TextField fx:id="imagePathField" promptText="Путь к файлу изображения" HBox.hgrow="ALWAYS"/>
            </HBox>
        </GridPane>

        <Separator/>

        <HBox alignment="CENTER" spacing="20.0">
            <Button fx:id="saveButton" text="Сохранить" style="-fx-background-color: #27ae60; -fx-text-fill: white;"
                    onAction="#saveProduct"/>

        </HBox>
    </VBox>
</HBox>