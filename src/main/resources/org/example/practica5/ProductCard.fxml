<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="rootPane" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.practica5.Controller.ProductCardController"
            prefHeight="150.0" prefWidth="500.0"
            style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

    <HBox spacing="15.0" AnchorPane.topAnchor="10.0" AnchorPane.bottomAnchor="10.0"
          AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">

        <ImageView fx:id="imgCard" fitHeight="100.0" fitWidth="100.0" preserveRatio="true"/>

        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <Label fx:id="nameProduct" style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Название"/>
            <Label fx:id="descriptionProduct" style="-fx-text-fill: #666; -fx-font-size: 12px;" text="Описание"/>
            <Label fx:id="provider" style="-fx-text-fill: #888; -fx-font-size: 11px;" text="Поставщик"/>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Text fx:id="txtPrice" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="0.00 ₽"/>
                <Label fx:id="txtTotalPrice" style="-fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-font-size: 14px;" text="Итог: 0.00 ₽" visible="false"/>
                <Label fx:id="txtDiscount" style=" -fx-text-fill: white; -fx-padding: 2 8 2 8; -fx-background-radius: 4; -fx-font-size: 11px;" text="-0%" visible="false"/>
            </HBox>

            <Label fx:id="txtQuantity" style="-fx-text-fill: #555; -fx-font-size: 12px;" text="В наличии: 0 шт."/>
        </VBox>
    </HBox>
</AnchorPane>