<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.practica5.Controller.ProductController"
      minWidth="800.0" minHeight="600.0">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <HBox alignment="CENTER_RIGHT" spacing="15.0" maxHeight="500" style="-fx-background-color: green" minWidth="700" minHeight="100">
        <HBox>
            <ImageView fitHeight="104.0" fitWidth="86.0" pickOnBounds="true" preserveRatio="true">
                <image >
                    <Image url="@images/icon.png" />
                </image>
            </ImageView>
        </HBox>
        <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
            <Label fx:id="userNameLabel" style="-fx-text-fill:white; -fx-font-size: 14px;" text="Пользователь:"/>
            <Label fx:id="userRoleLabel" style="-fx-text-fill:white;" text="Роль:"/>
        </VBox>
    </HBox>

    <Separator/>

    <HBox spacing="10.0">
        <TextField fx:id="searchField" promptText="Поиск товаров..." HBox.hgrow="ALWAYS"/>
        <Button fx:id="searchButton" onAction="#handleSearch"
                style="-fx-background-color: #3498db; -fx-text-fill: white;"
                text="Найти"/>
    </HBox>

    <HBox spacing="10.0">
        <ComboBox fx:id="categoryFilter" promptText="Категория" prefWidth="150.0"/>
        <ComboBox fx:id="providerFilter" promptText="Поставщик" prefWidth="150.0"/>
        <ComboBox fx:id="sortBy" promptText="Сортировка" prefWidth="200.0"/>
        <Button fx:id="applyFilterButton"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white;"
                text="Применить"/>
    </HBox>

    <ListView fx:id="productsListView" VBox.vgrow="ALWAYS"
              style=" -fx-background-radius: 5;"/>

    <Separator/>




    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="logoutButton" onAction="#handleLogout" text="Выход"/>
        <Button fx:id="btnOrders"  text="Заказы" />
    </HBox>

    <HBox fx:id="adminPanel" spacing="10.0" alignment="CENTER_RIGHT">
        <Button fx:id="addProductButton"  text="Добавить товар"/>
        <Button fx:id="editProductButton"  text="Редактировать"/>
        <Button fx:id="deleteProductButton"  text="Удалить"/>


    </HBox>

</VBox>